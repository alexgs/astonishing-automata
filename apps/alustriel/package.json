{
  "name": "alustriel",
  "version": "0.0.0",
  "description": "Back-end for _Automata Character Builder_",
  "author": {
    "email": "alex.nebula99@gmail.com",
    "name": "Alex Gates-Shannon"
  },
  "license": "OSL-3.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "npm run start:dev",
    "format": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"integration-tests/**/*.ts\" \"module-tests/**/*.ts\"",
    "format:fix": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"integration-tests/**/*.ts\" \"module-tests/**/*.ts\"",
    "lint": "eslint \"{src,apps,libs,test,integration-tests,module-tests}/**/*.ts\"",
    "lint:fix": "eslint \"{src,apps,libs,test,integration-tests,module-tests}/**/*.ts\" --fix",
    "start": "nest start",
    "start:debug": "nest start --debug --watch",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "test": "jest",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:mod": "NODE_ENV=module-test jest --config module-tests/jest.module-tests.json",
    "test:mod:watch": "NODE_ENV=module-test jest --config module-tests/jest.module-tests.json --watch",
    "test:int": "NODE_ENV=integration-test jest --config integration-tests/jest.integration-tests.json",
    "test:int:watch": "NODE_ENV=integration-test jest --config integration-tests/jest.integration-tests.json --watch",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/cqrs": "^11.0.2",
    "@nestjs/platform-express": "^10.0.0",
    "knex": "^3.1.0",
    "nest-winston": "^1.10.2",
    "pg": "^8.13.3",
    "postgres": "^3.4.5",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "ulidx": "^2.4.1",
    "winston": "^3.17.0",
    "xstate": "^5.19.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.2",
    "@types/ms": "^2.1.0",
    "@types/node": "^20.3.1",
    "@types/supertest": "^2.0.12",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "axios": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "env-var": "^7.5.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.0.0",
    "eslint-import-resolver-typescript": "^3.8.3",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.5.0",
    "knex-mock-client": "^3.0.2",
    "prettier": "3.5.3",
    "source-map-support": "^0.5.21",
    "superagent": "^9.0.2",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "5.3.x"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "volta": {
    "node": "22.14.0",
    "npm": "11.1.0"
  }
}
