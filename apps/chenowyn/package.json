{
  "name": "chenowyn",
  "version": "0.0.0",
  "description": "Front-end for _Automata Character Builder_",
  "author": {
    "email": "alex.nebula99@gmail.com",
    "name": "Alex Gates-Shannon"
  },
  "license": "Elastic License 2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "dev": "vite dev --host",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint": "eslint .",
    "prepare": "npm run prepare:sveltekit",
    "prepare:sveltekit": "svelte-kit sync || echo ''",
    "preview": "vite preview",
    "test": "vitest --run --project unit --project logic",
    "test:e2e": "playwright test",
    "test:watch": "vitest --project unit --project logic"
  },
  "devDependencies": {
    "@automata/grimoire": "*",
    "@clerk/clerk-js": "^5.70.0",
    "@eslint/compat": "^1.2.5",
    "@eslint/js": "^9.18.0",
    "@playwright/test": "^1.49.1",
    "@smui/button": "^8.0.0-beta.3",
    "@smui/drawer": "^8.0.0-beta.3",
    "@smui/form-field": "^8.0.0-beta.3",
    "@smui/layout-grid": "^8.0.0-beta.3",
    "@smui/list": "^8.0.0-beta.3",
    "@smui/radio": "^8.0.0-beta.3",
    "@smui/textfield": "^8.0.0-beta.3",
    "@smui/top-app-bar": "^8.0.0-beta.3",
    "@sveltejs/adapter-static": "^3.0.8",
    "@sveltejs/kit": "^2.16.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/svelte": "^5.2.8",
    "@types/dlv": "^1.1.5",
    "@types/lodash.set": "^4.3.9",
    "@vitest/browser": "^3.2.3",
    "bits-ui": "^2.8.11",
    "dlv": "^1.1.3",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-import-resolver-typescript": "^4.2.2",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-svelte": "^3.0.0",
    "globals": "^16.0.0",
    "lodash.set": "^4.3.2",
    "playwright": "^1.53.0",
    "prettier": "^3.4.2",
    "prettier-plugin-svelte": "^3.3.3",
    "sass": "^1.89.2",
    "smui-theme": "^8.0.0-beta.3",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.20.0",
    "vite": "^6.2.6",
    "vite-plugin-devtools-json": "^0.2.0",
    "vitest": "^3.2.3",
    "vitest-browser-svelte": "^0.1.0",
    "zod": "^3.25.74"
  },
  "volta": {
    "node": "22.14.0",
    "npm": "11.1.0"
  }
}
