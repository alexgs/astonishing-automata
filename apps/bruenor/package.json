{
  "name": "bruenor",
  "version": "0.0.0",
  "description": "Front-end for _Automata Character Builder_",
  "author": {
    "email": "alex.nebula99@gmail.com",
    "name": "Alex Gates-Shannon"
  },
  "license": "Elastic License 2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "dev": "vite dev --host",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint": "eslint .",
    "prepare": "npm run prepare:sveltekit && npm run smui-theme-dark",
    "prepare:sveltekit": "svelte-kit sync || echo ''",
    "preview": "vite preview",
    "smui-theme-dark": "smui-theme compile static/smui-dark.css -i src/theme/dark",
    "test": "vitest --run",
    "test:watch": "vitest --watch",
    "test:unit": "vitest"
  },
  "devDependencies": {
    "@automata/state-machine": "*",
    "@clerk/clerk-js": "^5.57.2",
    "@eslint/compat": "^1.2.5",
    "@eslint/js": "^9.18.0",
    "@smui/button": "^8.0.0-beta.3",
    "@smui/drawer": "^8.0.0-beta.3",
    "@smui/layout-grid": "^8.0.0-beta.3",
    "@smui/list": "^8.0.0-beta.3",
    "@smui/top-app-bar": "^8.0.0-beta.3",
    "@sveltejs/adapter-static": "^3.0.8",
    "@sveltejs/kit": "^2.16.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/svelte": "^5.2.4",
    "@typescript-eslint/parser": "^8.27.0",
    "@xstate/svelte": "^4.0.3",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-import-resolver-typescript": "^4.2.2",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-svelte": "^3.0.0",
    "globals": "^16.0.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.4.2",
    "prettier-plugin-svelte": "^3.3.3",
    "smui-theme": "^8.0.0-beta.3",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.27.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0",
    "zod": "^3.24.2"
  },
  "volta": {
    "node": "22.14.0",
    "npm": "11.1.0"
  }
}
